# ==========================================
# DuitQ Backend Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=production
PORT=5001

# Database (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/duitq?retryWrites=true&w=majority

# JWT Authentication
# PENTING: Gunakan string acak minimal 32+ karakter (dapat digenerate dengan: openssl rand -hex 32)
JWT_SECRET=generate_your_secure_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins
# URL domain frontend yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://duitq.app,https://www.duitq.app
FRONTEND_URL=https://your-frontend-domain.com

# Cookie Security (Cross-Origin Setup)
# 'none' wajib jika frontend & backend berada di domain berbeda di production (misal Vercel + Railway)
# 'lax' jika frontend & backend di domain yang sama (misal reverse proxy / subdomain yang sama)
COOKIE_SAME_SITE=none

# ==========================================
# Email Provider Configuration
# Pilihan EMAIL_PROVIDER: 'gmail' | 'smtp' | 'mailtrap'
# ==========================================
EMAIL_PROVIDER=gmail

# Jika EMAIL_PROVIDER=gmail:
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="DuitQ <your_gmail_address@gmail.com>"

# Jika EMAIL_PROVIDER=mailtrap (Opsional):
MAILTRAP_TOKEN=
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME="DuitQ"
